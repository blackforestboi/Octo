{
  "name": "octo-app",
  "version": "2026.8.113",
  "description": "Release metadata + changelog automation for the Octo macOS app.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "release": "bash release/local-release.sh",
    "release:local": "bash release/local-release.sh --local-build",
    "install:local-release": "bash release/fast-install.sh",
    "changeset": "changeset",
    "changeset:add": "changeset",
    "changeset:add-ai": "bun run tools/scripts/add-changeset.ts",
    "changeset:status": "changeset status --verbose",
    "changeset:version": "changeset version",
    "sync-changelog": "bun run tools/scripts/sync-changelog.ts",
    "test": "echo test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0"
  }
}
